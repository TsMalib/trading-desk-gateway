# Copy to .env and fill in. Never commit .env.
# Quarkus dev mode reads .env from the project root; docker-compose reads it too.

# --- Desk ---
# paper | live. Single switch between IBKR paper and live; shown in every Telegram message.
DESK_MODE=
# HTTP port of the gateway (default 8080).
HTTP_PORT=

# --- IB Gateway ---
# Host where IB Gateway / TWS listens (default 127.0.0.1).
IB_HOST=
# IB Gateway API port: 4002 paper, 4001 live (default 4002).
IB_PORT=
# TWS API client id for this service; must be unique per connection (default 1).
IB_CLIENT_ID=
# Market data type: 1 live (default), 3 delayed (when the account has no live subscription;
# quotes are then flagged delayed=true).
IB_MARKET_DATA_TYPE=

# --- Telegram ---
# Bot token from @BotFather. Secret.
TELEGRAM_BOT_TOKEN=
# Chat id the bot posts proposals and notifications to.
TELEGRAM_CHAT_ID=
# Telegram user id of the owner; the only user whose Approve taps are accepted.
TELEGRAM_USER_ID=

# --- MCP ---
# API key the research bots must send to the MCP endpoint. Secret.
MCP_API_KEY=

# --- Risk ---
# Comma-separated symbols that may be proposed, e.g. AAPL,MSFT.
RISK_WHITELIST=

# --- Database (prod only; dev and test use Dev Services) ---
# JDBC URL, e.g. jdbc:postgresql://db:5432/desk.
DB_JDBC_URL=
# Database user.
DB_USERNAME=
# Database password. Secret.
DB_PASSWORD=
