# Every variable, no values. Never commit .env.
# Local: copy to .env next to the compose files (docker compose reads it for ${...} substitution) or the
# project root for mvn quarkus:dev. Production (Portainer): set these as stack environment variables;
# no .env file on the host. See docs/portainer.md for which stack needs which.

# ============================================================================
# App stack (docker-compose.yml)
# ============================================================================

# --- Image ---
# Release to run: the git tag the image was built from, e.g. v0.1.0. Change it to roll back.
DESK_VERSION=
# GHCR owner (lowercase), default tsmalib.
GHCR_OWNER=

# --- Desk ---
# paper | live. Single switch between IBKR paper and live; shown in every Telegram message.
DESK_MODE=
# HTTP port of the app inside its container (default 8080). Leave empty in compose.
HTTP_PORT=

# --- IB Gateway (as seen from the app) ---
# Host of IB Gateway: ib-gateway in compose (default), 127.0.0.1 for mvn quarkus:dev.
IB_HOST=
# Container to container: 4004 paper, 4003 live. On the host (published loopback port): 4002 paper.
IB_PORT=
# TWS API client id for this service; must be unique per connection (default 1).
IB_CLIENT_ID=
# Market data type: 1 live (default), 3 delayed (quotes are then flagged delayed=true).
IB_MARKET_DATA_TYPE=

# --- Telegram ---
# Bot token from @BotFather. Secret.
TELEGRAM_BOT_TOKEN=
# Chat id the bot posts proposals and notifications to.
TELEGRAM_CHAT_ID=
# Telegram user id of the owner; the only user whose Approve taps are accepted.
TELEGRAM_USER_ID=

# --- MCP ---
# API key the research bots send in header X-Desk-Key. Secret. openssl rand -hex 32
MCP_API_KEY=

# --- Risk ---
# Comma-separated symbols that may be proposed, e.g. AAPL,MSFT.
RISK_WHITELIST=

# --- Database (prod only; dev and test use Dev Services) ---
# JDBC URL of your existing Postgres, e.g. jdbc:postgresql://postgres:5432/desk (shared Docker network)
# or jdbc:postgresql://192.168.1.10:5432/desk (host IP).
DESK_DB_URL=
# Database user.
DESK_DB_USER=
# Database password. Secret.
DESK_DB_PASSWORD=
# Only if you attach to the Postgres container's network (see docker-compose.yml): its network name.
POSTGRES_NETWORK=

# --- Cloudflare Tunnel ---
# Token of the tunnel (Zero Trust > Networks > Tunnels > your tunnel). Secret.
TUNNEL_TOKEN=

# ============================================================================
# IB Gateway stack (ib-gateway.yml)
# ============================================================================

# IBKR username: the paper user for paper, the live user for live. Secret.
TWS_USERID=
# IBKR password. Secret.
TWS_PASSWORD=
# paper | live. Must match DESK_MODE.
TRADING_MODE=
# Daily restart without 2FA, hh:mm AM/PM in TIME_ZONE (default 11:59 PM).
AUTO_RESTART_TIME=
# tz database name, e.g. Europe/Berlin (default). Only applied on first start (stored in jts.ini).
TIME_ZONE=
# IB Gateway Java heap in MB (default 1024).
JAVA_HEAP_SIZE=
# Optional VNC password; empty = VNC off. Secret.
VNC_SERVER_PASSWORD=
